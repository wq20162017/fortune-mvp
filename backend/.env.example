# === AI 配置 ===
AI_API_URL=https://api.siliconflow.cn/v1/chat/completions
AI_API_KEY=你的API密钥

# === 服务端口 ===
PORT=3001

# === 微信支付配置（可选，不配则用手动验证模式）===
# 微信公众号 AppID
WX_APPID=
# 微信公众号 AppSecret（OAuth用）
WX_APP_SECRET=
# 微信支付商户号
WX_MCHID=
# 微信支付 API v2 密钥
WX_API_KEY=
# 微信支付 API v3 密钥
WX_API_V3_KEY=
# API 证书序列号（v3）
WX_SERIAL_NO=
# API 私钥文件路径（v3）
WX_PRIVATE_KEY_PATH=
# 支付回调地址
WX_NOTIFY_URL=

# === 手动验证密钥（未配微信支付时使用）===
ADMIN_SECRET=change-me-to-a-strong-secret
